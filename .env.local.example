# Copie ce fichier en .env.local et renseigne les valeurs réelles.
# .env.local n'est jamais commité (voir .gitignore) — à définir aussi dans
# Vercel : Settings -> Environment Variables, avec les mêmes noms.

# Personal Access Token Airtable (scopes data.records:read et data.records:write,
# accès à la base appnyC5r7ZozZv90q) - textes, actualités et console d'administration.
AIRTABLE_API_KEY=

# Mot de passe de la console d'administration (/admin), partagé par l'association.
ADMIN_PASSWORD=

# Longue chaîne aléatoire qui signe les connexions à la console. Ne jamais la communiquer.
ADMIN_SECRET=
